# CollabOS Makefile
# Builds a bootable ISO for CollabOS

# Compiler and tools configuration
CC = x86_64-elf-gcc
LD = x86_64-elf-ld
AS = nasm
GRUB_MKRESCUE = i686-elf-grub-mkrescue
CFLAGS = -std=gnu99 -ffreestanding -O2 -Wall -Wextra -nostdlib -fno-builtin -fno-stack-protector -m32
LDFLAGS = -T linker.ld -nostdlib -m elf_i386
ASFLAGS = -felf32

# Directories
SRCDIR = kernel
INCDIR = include
BUILDDIR = build
ISODIR = $(BUILDDIR)/iso
BOOTDIR = $(ISODIR)/boot

# Source files
C_SOURCES = $(filter-out $(SRCDIR)/main_desktop.c, $(wildcard $(SRCDIR)/*.c))
ASM_SOURCES = $(wildcard $(SRCDIR)/*.s)

# Object files
C_OBJECTS = $(C_SOURCES:$(SRCDIR)/%.c=$(BUILDDIR)/%.o)
ASM_OBJECTS = $(ASM_SOURCES:$(SRCDIR)/%.s=$(BUILDDIR)/%.o)
OBJECTS = $(C_OBJECTS) $(ASM_OBJECTS)

# Target files
KERNEL = $(BUILDDIR)/kernel.bin
ISO = $(BUILDDIR)/collabos.iso

.PHONY: all clean run install-deps

all: $(ISO)

# Create kernel binary
$(KERNEL): $(OBJECTS) | $(BUILDDIR)
	$(LD) $(LDFLAGS) -o $@ $^

# Compile C source files
$(BUILDDIR)/%.o: $(SRCDIR)/%.c | $(BUILDDIR)
	$(CC) $(CFLAGS) -I$(INCDIR) -c $< -o $@

# Assemble ASM source files
$(BUILDDIR)/%.o: $(SRCDIR)/%.s | $(BUILDDIR)
	$(AS) $(ASFLAGS) $< -o $@

# Create bootable ISO
$(ISO): $(KERNEL) | $(BOOTDIR)
	cp $(KERNEL) $(BOOTDIR)/kernel.bin
	cp boot/grub.cfg $(BOOTDIR)/grub/
	$(GRUB_MKRESCUE) -o $(ISO) $(ISODIR)

# Create build directories
$(BUILDDIR):
	mkdir -p $(BUILDDIR)

$(BOOTDIR): | $(BUILDDIR)
	mkdir -p $(BOOTDIR)/grub

# Run in QEMU
run: $(ISO)
	qemu-system-i386 -cdrom $(ISO) -m 512M

# Run in QEMU with networking support for testing
run-net: $(ISO)
	qemu-system-i386 -cdrom $(ISO) -m 512M -netdev user,id=net0 -device rtl8139,netdev=net0

# Run two VMs for testing networking between them
run-dual: $(ISO)
	@echo "Starting VM 1..."
	qemu-system-i386 -cdrom $(ISO) -m 512M -name "CollabOS-VM1" &
	@echo "Starting VM 2..."
	qemu-system-i386 -cdrom $(ISO) -m 512M -name "CollabOS-VM2" &

# Clean build files
clean:
	rm -rf $(BUILDDIR)

# Install development dependencies
install-deps:
	@echo "Installing CollabOS development dependencies..."
	@echo "Make sure you have the following installed:"
	@echo "- x86_64-elf-gcc (cross-compiler for i386 target)"
	@echo "- qemu-system-i386"
	@echo "- grub-mkrescue (or xorriso)"
	@echo "- nasm"
	@echo ""
	@echo "On macOS with Homebrew (Apple Silicon):"
	@echo "brew install qemu x86_64-elf-gcc nasm xorriso"
	@echo ""
	@echo "On Ubuntu/Debian:"
	@echo "sudo apt-get install qemu-system-x86 gcc-multilib nasm grub2-common xorriso"

# Debug with GDB
debug: $(ISO)
	qemu-system-i386 -cdrom $(ISO) -m 512M -s -S &
	gdb -ex "target remote localhost:1234" -ex "continue"

# Help target
help:
	@echo "CollabOS Build System"
	@echo "====================="
	@echo ""
	@echo "Available targets:"
	@echo "  all         - Build the CollabOS ISO (default)"
	@echo "  run         - Build and run CollabOS in QEMU"
	@echo "  run-net     - Run with networking support"
	@echo "  run-dual    - Run two VMs for testing collaboration"
	@echo "  clean       - Remove all build files"
	@echo "  install-deps- Show dependency installation instructions"
	@echo "  debug       - Run with GDB debugging support"
	@echo "  help        - Show this help message"
	@echo ""
	@echo "Example usage:"
	@echo "  make          # Build the OS"
	@echo "  make run      # Build and run in VM"
	@echo "  make clean    # Clean build files"